---
import footerPoster from "../assets/images/footerposter.png";
import doodleBg from "../assets/images/doodle.png";
---

<!-- Outer wrapper: cream bg + padding for gap effect -->
<div class="footer-cta-section relative w-full px-6 md:px-10 py-6" style="background-color: #FAF5EB;">
  <!-- Doodle Pattern Overlay -->
  <div 
    class="absolute inset-0 pointer-events-none z-0" 
    style={`
      background-image: url(${doodleBg.src}); 
      background-repeat: repeat; 
      background-size: 400px; 
      mix-blend-mode: multiply;
    `}
  ></div>

  <section class="relative overflow-hidden rounded-2xl">
    <!-- Image defines the section height naturally -->
    <img
      src={footerPoster.src}
      alt="Ritual background"
      class="block w-full h-auto"
      style="display: block;"
    />

    <!-- Content overlaid: text left, button right -->
    <div class="absolute inset-0 flex items-center px-8 md:px-16">
      <div class="flex justify-between items-center w-[74%] m-auto gap-4">
        <div class="flex-1">
          <h2
            id="typing-header"
            class="text-2xl md:text-[46px] font-bold mb-4 leading-tight opacity-0"
            style="font-family: 'Noto Serif', serif; color: #FFEFA4;"
            data-text="Still Unsure Which Ritual is Right for You?"
          >
            Still Unsure Which Ritual is Right for You?
          </h2>
          <p
            class="text-white text-xl md:text-2xl font-medium reveal-text opacity-0 transition-opacity duration-1000 delay-500"
            style="font-family: 'Manrope', sans-serif;"
          >
            Our Vedic experts are here to guide you based on your birth star <br
            />and life situation. Get personalized advice.
          </p>
        </div>

        <!-- Right: Book Now button -->
        <div class="flex-shrink-0 reveal-text opacity-0 transition-all duration-1000 delay-700">
          <a
            href="/yagam"
            class="cta-book-btn inline-flex items-center gap-4 px-10 py-4 font-bold text-lg"
            style="font-family: 'Manrope', sans-serif; color: #FFFFFF; background-color: #3B0100; border: 2px solid rgba(255,255,255,0.9); border-radius: 6px; white-space: nowrap; letter-spacing: 0.01em; transition: all 0.3s ease;"
          >
            Book Now
            <svg
              class="cta-arrow"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#F2B43D"
              stroke-width="3"
            >
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  function typeWriter(element: any, text: any, speed = 40) {
    if (element.dataset.isTyping === 'true') return;
    element.dataset.isTyping = 'true';
    element.innerHTML = '';
    element.classList.remove('opacity-0');
    let i = 0;
    function type() {
      if (i < text.length) {
        element.innerHTML += text.charAt(i);
        i++;
        setTimeout(type, speed);
      } else {
        element.dataset.isTyping = 'false';
      }
    }
    type();
  }

  const observerOptions = {
    threshold: 0.2,
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      const header = entry.target.querySelector('#typing-header') as any;
      const subtexts = entry.target.querySelectorAll('.reveal-text');
      
      if (entry.isIntersecting) {
        if (header && header.classList.contains('opacity-0')) {
          typeWriter(header, header.getAttribute('data-text'));
          subtexts.forEach(el => {
            el.classList.remove('opacity-0');
            el.classList.add('opacity-100');
          });
        }
      } else {
        if (header) {
          header.classList.add('opacity-0');
          header.innerHTML = '';
          header.dataset.isTyping = 'false';
        }
        subtexts.forEach(el => {
          el.classList.add('opacity-0');
          el.classList.remove('opacity-100');
        });
      }
    });
  }, observerOptions);

  document.querySelectorAll('.footer-cta-section').forEach(target => {
    observer.observe(target);
  });
</script>

<style>
  .cta-book-btn:hover {
    background-color: #ffffff !important;
    color: #000000 !important;
    border-color: #ffffff !important;
    transform: scale(1.03);
  }

  .cta-book-btn:hover .cta-arrow {
    transform: translateX(4px);
    stroke: #000000;
  }

  .cta-arrow {
    transition: all 0.3s ease;
  }
</style>
