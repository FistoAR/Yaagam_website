---
import logo from "../assets/images/logo.png";

const navItems = [
  { name: "About", href: "/about" },
  { name: "Yagam", href: "/yagam" },
  { name: "Events", href: "/events" },
  { name: "Gallery", href: "/gallery" },
  { name: "Contact", href: "/contact" },
];
---

<nav
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 group/nav"
  id="main-nav"
>
  <div class="mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="flex justify-between items-center h-20 transition-all duration-300"
      id="nav-container"
    >
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="group flex items-center space-x-3">
          <div
            class="flex items-center justify-center transform group-hover:rotate-12 transition-transform duration-500"
          >
            <img src={logo.src} alt="Logo" class="h-15 w-15" />
          </div>
          <div class="flex flex-col">
            <span
              class="text-2xl font-display font-bold text-white group-hover:text-gold-400 transition-colors tracking-wider"
              id="logo-text">Kanika </span
            >
            <span
              class="text-[10px] font-body text-gold-300 uppercase tracking-[0.3em] -mt-1 opacity-80"
              >Parameshwari</span
            >
          </div>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="nav-link text-white/90 hover:text-gold-400 font-medium transition-colors duration-200 relative group"
            >
              {item.name}
              <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-gold-500 transition-all duration-300 group-hover:w-full" />
            </a>
          ))
        }
        <button
          class="bg-gold-500 text-slate-900 px-6 py-2.5 rounded-xl font-bold hover:bg-gold-400 transition-all duration-300 transform hover:-translate-y-0.5 shadow-lg shadow-gold-500/20"
        >
          Book Now
        </button>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center">
        <button
          id="mobile-menu-button"
          class="inline-flex items-center justify-center p-2 rounded-lg text-white hover:text-gold-400 focus:outline-none transition-colors"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              id="menu-icon"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
            <path
              id="close-icon"
              class="hidden"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    class="hidden md:hidden bg-slate-900/95 backdrop-blur-xl border-t border-white/10"
    id="mobile-menu"
  >
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="block px-3 py-3 rounded-lg text-base font-medium text-white/80 hover:text-gold-400 hover:bg-white/5 transition-colors"
          >
            {item.name}
          </a>
        ))
      }
      <div class="pt-4 pb-2 border-t border-white/10">
        <button
          class="w-full bg-gold-500 text-slate-900 px-6 py-3 rounded-xl font-bold hover:bg-gold-400 transition-colors"
        >
          Book Now
        </button>
      </div>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById("main-nav");
  const navContainer = document.getElementById("nav-container");
  const logoText = document.getElementById("logo-text");
  const navLinks = document.querySelectorAll(".nav-link");
  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuIcon = document.getElementById("menu-icon");
  const closeIcon = document.getElementById("close-icon");

  // Navbar scroll effect
  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      nav?.classList.add("bg-white/90", "backdrop-blur-lg", "shadow-lg");
      navContainer?.classList.replace("h-20", "h-16");
      logoText?.classList.replace("text-white", "text-slate-900");
      navLinks.forEach((link) => {
        (link as HTMLElement).classList.replace("text-white/90", "text-slate-600");
      });
      mobileMenuButton?.classList.replace("text-white", "text-slate-900");
    } else {
      nav?.classList.remove("bg-white/90", "backdrop-blur-lg", "shadow-lg");
      navContainer?.classList.replace("h-16", "h-20");
      logoText?.classList.replace("text-slate-900", "text-white");
      navLinks.forEach((link) => {
        (link as HTMLElement).classList.replace("text-slate-600", "text-white/90");
      });
      mobileMenuButton?.classList.replace("text-slate-900", "text-white");
    }
  });

  // Mobile menu toggle
  mobileMenuButton?.addEventListener("click", () => {
    const isHidden = mobileMenu?.classList.contains("hidden");
    if (isHidden) {
      mobileMenu?.classList.remove("hidden");
      menuIcon?.classList.add("hidden");
      closeIcon?.classList.remove("hidden");
    } else {
      mobileMenu?.classList.add("hidden");
      menuIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    }
  });
</script>
