---
import MainLayout from '../layouts/MainLayout.astro';
import FooterCTA from '../components/FooterCTA.astro';

const events = [
  {
    title: 'Jwala Mukhi Yagam',
    date: 'July 14, 2026',
    time: '6:00 AM – 12:00 PM',
    location: 'Sree Kanika Parameshwari Temple, Bangalore',
    type: 'Yagam',
    spots: 12,
  },
  {
    title: 'Thaipusam Kumbabishekam',
    date: 'August 2, 2026',
    time: '5:30 AM – 11:00 AM',
    location: 'Neganam Karupanaya Swamy Temple',
    type: 'Festival',
    spots: 50,
  },
  {
    title: 'Maha Ashwamedha Yagam',
    date: 'September 7, 2026',
    time: '6:00 AM – 6:00 PM',
    location: 'Sree Kanika Parameshwari Temple, Bangalore',
    type: 'Yagam',
    spots: 6,
  },
  {
    title: 'Sri Sukta Homam',
    date: 'October 15, 2026',
    time: '12:00 PM – 4:00 PM',
    location: 'Heritage Nagar Temple Complex',
    type: 'Homam',
    spots: 20,
  },
  {
    title: 'Navaratri Mahotsav',
    date: 'October 22–30, 2026',
    time: '6:00 AM – 9:00 PM (Daily)',
    location: 'Sree Kanika Parameshwari Temple, Bangalore',
    type: 'Festival',
    spots: 200,
  },
  {
    title: 'Brahma Saraswati Mahayagam',
    date: 'November 20, 2026',
    time: '6:00 AM – 8:00 PM',
    location: 'Sree Kanika Parameshwari Temple, Bangalore',
    type: 'Yagam',
    spots: 8,
  },
];

const typeColors: Record<string, string> = {
  Yagam:   '#5C1010',
  Festival: '#2C5C10',
  Homam:    '#1A3A5C',
};
---

<MainLayout title="Events — Sree Kanika Parameshwari Trust" description="Upcoming sacred events, yagams, festivals, and homams organised by Sree Kanika Parameshwari Trust.">
  <div style="background-color: #FAF5EB; min-height: 100vh; padding-top: 80px; font-family: 'Inter', sans-serif;">

    <!-- Page Header -->
    <section class="py-14 text-center px-6">
      <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: #C9A227;">Sacred Calendar</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-4" style="color: #2C0808; font-family: 'Playfair Display', serif;">
        Upcoming Events
      </h1>
      <p class="text-base max-w-xl mx-auto" style="color: #5C3030;">
        Join us in celebration of our sacred rituals, festivals, and community gatherings rooted in Vedic tradition.
      </p>
    </section>

    <!-- Events Grid -->
    <section class="max-w-7xl mx-auto px-6 pb-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {events.map(event => (
          <div class="bg-white rounded-xl overflow-hidden shadow-sm border transition-all duration-300 hover:shadow-md hover:-translate-y-1" style="border-color: #E8D5B5;">
            <!-- Image placeholder -->
            <div class="relative" style="height: 180px; background: linear-gradient(135deg, #2A1000 0%, #5C2800 100%);">
              <div class="w-full h-full flex items-center justify-center opacity-20">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#C9A227" stroke-width="1">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
              </div>
              <!-- Type badge -->
              <span class="absolute top-3 left-3 text-xs font-semibold px-2.5 py-1 rounded-full text-white"
                style={`background-color: ${typeColors[event.type] ?? '#5C1010'};`}>
                {event.type}
              </span>
            </div>

            <div class="p-5">
              <h3 class="font-bold text-base mb-3 leading-tight" style="color: #2C0808; font-family: 'Playfair Display', serif;">
                {event.title}
              </h3>

              <div class="space-y-2 mb-4">
                <div class="flex items-center gap-2 text-xs" style="color: #5C3030;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C9A227" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                  </svg>
                  <span>{event.date}</span>
                </div>
                <div class="flex items-center gap-2 text-xs" style="color: #5C3030;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C9A227" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                  </svg>
                  <span>{event.time}</span>
                </div>
                <div class="flex items-center gap-2 text-xs" style="color: #5C3030;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C9A227" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                  </svg>
                  <span>{event.location}</span>
                </div>
              </div>

              <div class="flex items-center justify-between pt-3 border-t" style="border-color: #F0E0C8;">
                <span class="text-xs" style="color: #7A4444;">{event.spots} spots available</span>
                <a href="/yagam/book"
                  class="text-xs px-4 py-2 rounded font-semibold text-white transition-all hover:opacity-90"
                  style="background-color: #5C1010;">
                  Register
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <FooterCTA />
  </div>
</MainLayout>
