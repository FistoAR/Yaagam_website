---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="QR Code Generator" activePage="qr-generator">
  <div class="admin-grid-2">
    <!-- Left: Form -->
    <div class="panel">
      <div class="panel-header">
        <h3>Generate New QR Code</h3>
      </div>
      <div class="panel-body">
        <form id="qrForm">
          <div class="form-group">
            <label for="customerName">Customer Name *</label>
            <input type="text" id="customerName" class="form-control" placeholder="Enter customer name" required />
          </div>
          <div class="form-group">
            <label for="phoneNumber">Phone Number *</label>
            <input type="tel" id="phoneNumber" class="form-control" placeholder="Enter phone number" required />
          </div>
          <div class="form-group">
            <label for="yaagamName">Yaagam Name *</label>
            <input type="text" id="yaagamName" class="form-control" placeholder="Enter yaagam name" required />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="eventDate">Event Date *</label>
              <input type="date" id="eventDate" class="form-control" required />
            </div>
            <div class="form-group">
              <label for="eventTime">Event Time *</label>
              <input type="time" id="eventTime" class="form-control" required />
            </div>
          </div>
          <div class="form-group">
            <label for="notes">Notes (Optional)</label>
            <textarea id="notes" class="form-control" placeholder="Any additional notes..."></textarea>
          </div>
          <button type="submit" class="btn btn-primary" id="generateBtn" style="width:100%;justify-content:center;">
            <span id="genText"><i data-lucide="qr-code" style="width:16px;"></i> Generate QR Code</span>
            <span id="genSpin" style="display:none;"><i data-lucide="loader" class="spin" style="width:16px; animation: spin 1s linear infinite;"></i> Generating...</span>
          </button>
        </form>
      </div>
    </div>

    <!-- Right: Preview -->
    <div>
      <div class="panel" id="previewPanel" style="display:none;">
        <div class="panel-header">
          <h3>QR Code Preview</h3>
          <button class="btn btn-sm btn-secondary" id="downloadBtn">
            <i data-lucide="download" style="width:14px;"></i> Download
          </button>
        </div>
        <div class="panel-body">
          <div class="qr-preview-container">
            <div class="qr-frame" id="qrCanvas"></div>
            <div class="qr-details">
              <div id="qrCustomerName" style="font-size:1rem;font-weight:600;color:var(--text-primary);"></div>
              <div id="qrYaagamName" style="margin-top:4px;color:var(--accent);"></div>
              <div id="qrEventDate" style="margin-top:4px;"></div>
              <div class="key-text" id="qrKey"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Recent list -->
      <div class="panel">
        <div class="panel-header">
          <h3>Recently Generated</h3>
        </div>
        <div class="panel-body" style="padding:0;">
          <table class="data-table">
            <thead>
              <tr><th>S.No</th><th>Customer</th><th>Yaagam</th><th>Action</th></tr>
            </thead>
            <tbody id="recentQRBody">
              <tr><td colspan="4"><div class="loader"><i data-lucide="loader" class="spin" style="animation: spin 1s linear infinite;"></i></div></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- View QR Modal -->
  <div class="modal-overlay" id="viewQrModal">
    <div class="modal">
      <div class="modal-header">
        <h3 id="viewModalTitle">View QR Code</h3>
        <button class="modal-close" id="closeViewModal">&times;</button>
      </div>
      <div class="modal-body">
        <div class="qr-preview-container">
          <div class="qr-frame" id="modalQrCanvas"></div>
          <div class="qr-details">
            <div id="modalQrCustomerName" style="font-size:1.1rem;font-weight:700;color:var(--text-primary);"></div>
            <div id="modalQrYaagamName" style="margin-top:4px;color:var(--accent);font-weight:600;"></div>
            <div id="modalQrEventDate" style="margin-top:4px;color:var(--text-secondary);"></div>
            <div class="key-text" id="modalQrKey"></div>
          </div>
        </div>
      </div>
      <div class="modal-footer" style="justify-content: center;">
        <button class="btn btn-primary" id="modalDownloadBtn">
          <i data-lucide="download" style="width:14px;"></i> Download QR
        </button>
      </div>
    </div>
  </div>
</AdminLayout>

<!-- QRCode.js library -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<script is:inline>
  let currentQRData = null;

  // Load recent
  async function loadRecentQR() {
    try {
      const data = await apiCall('/qr/list.php?limit=8');
      const tbody = document.getElementById('recentQRBody');
      if (!data.qr_codes || data.qr_codes.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4"><div class="empty-state"><p>No QR codes yet</p></div></td></tr>';
      } else {
        tbody.innerHTML = data.qr_codes.map((q, index) => `
          <tr>
            <td>${index + 1}</td>
            <td style="color:var(--text-primary);font-weight:600;">${q.customer_name}</td>
            <td>${q.yaagam_name}</td>
            <td>
              <button class="btn btn-sm btn-secondary btn-icon" title="View QR" onclick="viewQrCode(${JSON.stringify(q).replace(/"/g,'&quot;')})">
                <i data-lucide="eye" style="width:14px;"></i>
              </button>
            </td>
          </tr>
        `).join('');
        lucide.createIcons();
      }
    } catch (err) {
      console.error(err);
    }
  }
  loadRecentQR();

  // Generate
  document.getElementById('qrForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('generateBtn');
    const genText = document.getElementById('genText');
    const genSpin = document.getElementById('genSpin');

    btn.disabled = true;
    genText.style.display = 'none';
    genSpin.style.display = 'inline';

    const eventDate = document.getElementById('eventDate').value;
    const eventTime = document.getElementById('eventTime').value;

    try {
      const data = await apiCall('/qr/generate.php', {
        method: 'POST',
        body: JSON.stringify({
          customer_name: document.getElementById('customerName').value.trim(),
          phone_number: document.getElementById('phoneNumber').value.trim(),
          yaagam_name: document.getElementById('yaagamName').value.trim(),
          event_datetime: `${eventDate} ${eventTime}:00`,
          notes: document.getElementById('notes').value.trim(),
        }),
      });

      currentQRData = data.qr_code;

      // Show preview
      const preview = document.getElementById('previewPanel');
      preview.style.display = 'block';

      // Render QR
      const qrCanvas = document.getElementById('qrCanvas');
      qrCanvas.innerHTML = '';
      new QRCode(qrCanvas, {
        text: currentQRData.verification_key,
        width: 220,
        height: 220,
        colorDark: '#0a0a1e',
        colorLight: '#ffffff',
        correctLevel: QRCode.CorrectLevel.H,
      });

      document.getElementById('qrCustomerName').textContent = currentQRData.customer_name;
      document.getElementById('qrYaagamName').textContent = currentQRData.yaagam_name;
      document.getElementById('qrEventDate').textContent = new Date(currentQRData.event_datetime).toLocaleString('en-IN');
      document.getElementById('qrKey').textContent = currentQRData.verification_key;

      showToast('QR Code generated successfully!', 'success');
      document.getElementById('qrForm').reset();
      loadRecentQR();
    } catch (err) {
      showToast(err.message, 'error');
    } finally {
      btn.disabled = false;
      genText.style.display = 'inline';
      genSpin.style.display = 'none';
    }
  });

  // View existing QR
  window.viewQrCode = function(qr) {
    currentQRData = qr;
    const modal = document.getElementById('viewQrModal');
    modal.classList.add('open');
    
    const qrCanvas = document.getElementById('modalQrCanvas');
    qrCanvas.innerHTML = '';
    
    // We encode the key as JSON so the app can easily parse it
    const qrText = JSON.stringify({ key: qr.verification_key });
    
    new QRCode(qrCanvas, {
      text: qrText,
      width: 220,
      height: 220,
      colorDark: '#0a0a1e',
      colorLight: '#ffffff',
      correctLevel: QRCode.CorrectLevel.H,
    });

    document.getElementById('modalQrCustomerName').textContent = qr.customer_name;
    document.getElementById('modalQrYaagamName').textContent = qr.yaagam_name;
    document.getElementById('modalQrEventDate').textContent = new Date(qr.event_datetime).toLocaleString('en-IN');
    document.getElementById('modalQrKey').textContent = qr.verification_key;
  };

  document.getElementById('closeViewModal').addEventListener('click', () => {
    document.getElementById('viewQrModal').classList.remove('open');
  });

  // Download QR Logic (handles both preview and modal)
  function downloadQr(canvasContainerId) {
    const container = document.getElementById(canvasContainerId);
    if (!container) return;
    
    // qrcode.js sometimes creates an img instead of canvas depending on browser
    const img = container.querySelector('img');
    const canvas = container.querySelector('canvas');
    let dataUrl = '';
    
    if (img && img.src) {
      dataUrl = img.src;
    } else if (canvas) {
      dataUrl = canvas.toDataURL('image/png');
    }
    
    if (!dataUrl) {
      showToast('No QR code to download', 'error');
      return;
    }

    const link = document.createElement('a');
    link.download = `QR_${currentQRData?.customer_name || 'code'}_${currentQRData?.verification_key?.slice(0,8) || ''}.png`;
    link.href = dataUrl;
    link.click();
  }

  document.getElementById('downloadBtn').addEventListener('click', () => downloadQr('qrCanvas'));
  document.getElementById('modalDownloadBtn').addEventListener('click', () => downloadQr('modalQrCanvas'));
</script>
