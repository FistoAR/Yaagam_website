---
import MainLayout from '../layouts/MainLayout.astro';
import FooterCTA from '../components/FooterCTA.astro';
---

<MainLayout title="Contact — Sree Kanika Parameshwari Trust" description="Connect with us and seek blessings. Reach out to the Sree Kanika Parameshwari Trust for guidance and support.">
  <div style="background-color: #FAF5EB; min-height: 100vh; padding-top: 80px; font-family: 'Inter', sans-serif;">

    <!-- Page Header -->
    <section class="max-w-7xl mx-auto px-6 pt-12 pb-10">
      <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: #C9A227;">Connect With Us</p>
      <h1 class="text-3xl md:text-5xl font-bold mb-4" style="color: #2C0808; font-family: 'Playfair Display', serif;">
        Seek Blessings &amp; Support the Sanatana
      </h1>
      <p class="text-sm md:text-base max-w-2xl" style="color: #5C3030;">
        You are the most important being Seva, uplifting Spirits of Sanatana dharma on the most spiritual practices.
      </p>
    </section>

    <!-- Main Content -->
    <section class="max-w-7xl mx-auto px-6 pb-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">

        <!-- Left Column -->
        <div class="space-y-6">

          <!-- Registered Office Card -->
          <div class="bg-white rounded-xl p-7 shadow-sm border" style="border-color: #E8D5B5;">
            <h2 class="text-lg font-bold mb-5" style="color: #2C0808; font-family: 'Playfair Display', serif;">
              Registered Office
            </h2>
            <div class="space-y-5">
              <div class="flex items-start gap-4">
                <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: #FFF3E0;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A227" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-semibold mb-1" style="color: #7A4444;">Address</p>
                  <p class="text-sm" style="color: #2C0808;">108 Temple Road, Vasavi Inclusive,<br/>Spiritual District, Karnataka 56000</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: #FFF3E0;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A227" stroke-width="2">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.81a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-semibold mb-1" style="color: #7A4444;">Phone Number</p>
                  <p class="text-sm" style="color: #2C0808;">+91 38765 / 3210 / 000-234-6789</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: #FFF3E0;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A227" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-semibold mb-1" style="color: #7A4444;">Email ID</p>
                  <p class="text-sm" style="color: #2C0808;">seva@kanikaperameshwari.org</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Temple Timings Card -->
          <div class="bg-white rounded-xl p-7 shadow-sm border" style="border-color: #E8D5B5;">
            <h2 class="text-lg font-bold mb-5" style="color: #2C0808; font-family: 'Playfair Display', serif;">
              Temple Timings
            </h2>
            <div class="space-y-3">
              <div class="flex justify-between text-sm">
                <span style="color: #5C3030;">Morning Darshan</span>
                <span class="font-medium" style="color: #2C0808;">06:00 AM – 12:30 PM</span>
              </div>
              <div class="flex justify-between text-sm">
                <span style="color: #5C3030;">Evening Darshan</span>
                <span class="font-medium" style="color: #2C0808;">04:30 PM – 08:30 PM</span>
              </div>
              <p class="text-xs mt-4 italic" style="color: #7A4444;">
                * Special rituals and Aarti follow seasonal vedic schedules.
              </p>
            </div>
          </div>

          <!-- Image Placeholder -->
          <div class="rounded-xl overflow-hidden" style="height: 200px; background: linear-gradient(135deg, #3D1A00 0%, #6B3010 100%);">
            <div class="w-full h-full flex items-center justify-center opacity-30">
              <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#C9A227" stroke-width="1">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- Right Column — Contact Form -->
        <div class="bg-white rounded-xl p-8 shadow-sm border" style="border-color: #E8D5B5;">
          <h2 class="text-2xl font-bold mb-2" style="color: #2C0808; font-family: 'Playfair Display', serif;">
            Send a Message
          </h2>
          <p class="text-sm mb-7" style="color: #7A4444;">
            Fill out the form below and our temple administration will get back to you shortly.
          </p>

          <form class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-xs font-medium mb-1.5" style="color: #5C3030;">Full Name</label>
                <input
                  type="text"
                  placeholder="Devotee Name"
                  class="w-full px-4 py-3 rounded-lg text-sm outline-none transition-all duration-200"
                  style="border: 1px solid #E8D5B5; background: #FDFAF5; color: #2C0808;"
                  onfocus="this.style.borderColor='#C9A227'; this.style.boxShadow='0 0 0 3px rgba(201,162,39,0.1)'"
                  onblur="this.style.borderColor='#E8D5B5'; this.style.boxShadow='none'"
                />
              </div>
              <div>
                <label class="block text-xs font-medium mb-1.5" style="color: #5C3030;">Phone Number</label>
                <input
                  type="tel"
                  placeholder="+91"
                  class="w-full px-4 py-3 rounded-lg text-sm outline-none transition-all duration-200"
                  style="border: 1px solid #E8D5B5; background: #FDFAF5; color: #2C0808;"
                  onfocus="this.style.borderColor='#C9A227'; this.style.boxShadow='0 0 0 3px rgba(201,162,39,0.1)'"
                  onblur="this.style.borderColor='#E8D5B5'; this.style.boxShadow='none'"
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-medium mb-1.5" style="color: #5C3030;">Subject of Interest</label>
              <select
                class="w-full px-4 py-3 rounded-lg text-sm outline-none transition-all duration-200 appearance-none cursor-pointer"
                style="border: 1px solid #E8D5B5; background: #FDFAF5; color: #5C3030;"
                onfocus="this.style.borderColor='#C9A227'"
                onblur="this.style.borderColor='#E8D5B5'"
              >
                <option>General Inquiry</option>
                <option>Yagam Booking</option>
                <option>Donation</option>
                <option>Volunteer</option>
                <option>Spiritual Guidance</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-medium mb-1.5" style="color: #5C3030;">Your Message</label>
              <textarea
                rows="6"
                placeholder="How can the trust assist you?"
                class="w-full px-4 py-3 rounded-lg text-sm outline-none transition-all duration-200 resize-none"
                style="border: 1px solid #E8D5B5; background: #FDFAF5; color: #2C0808;"
                onfocus="this.style.borderColor='#C9A227'; this.style.boxShadow='0 0 0 3px rgba(201,162,39,0.1)'"
                onblur="this.style.borderColor='#E8D5B5'; this.style.boxShadow='none'"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3.5 rounded-lg text-white font-semibold text-sm transition-all duration-300 hover:opacity-90 active:scale-98"
              style="background-color: #5C1010;"
            >
              Submit Message
            </button>
          </form>
        </div>
      </div>
    </section>

    <FooterCTA />
  </div>
</MainLayout>
