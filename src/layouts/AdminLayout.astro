---
/**
 * AdminLayout.astro
 * Shared layout for all admin pages with sidebar navigation.
 */
interface Props {
  title: string;
  activePage: string;
}

import logoImg from '../assets/images/logo.png';

const { title, activePage } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} | KPT Admin</title>
  <link rel="stylesheet" href="/src/styles/admin.css" />
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="admin-body">
  <div class="admin-shell">
    <!-- Sidebar -->
    <aside class="admin-sidebar" id="sidebar">
      <div class="sidebar-brand">
        <img src={logoImg.src} alt="KP Trust Logo" class="mx-auto h-12 object-contain" style="max-height: 50px; display: block; margin: 0 auto;" />
        <span style="color: var(--text-muted); font-weight: 700; margin-top: 8px;">Admin Panel</span>
      </div>
      <nav class="sidebar-nav">
        <a href="/admin/dashboard" class={activePage === 'dashboard' ? 'active' : ''}>
          <i data-lucide="layout-dashboard" class="nav-icon"></i> Dashboard
        </a>
        <a href="/admin/qr-generator" class={activePage === 'qr-generator' ? 'active' : ''}>
          <i data-lucide="qr-code" class="nav-icon"></i> QR Generator
        </a>
        <a href="/admin/reports" class={activePage === 'reports' ? 'active' : ''}>
          <i data-lucide="file-bar-chart" class="nav-icon"></i> Reports
        </a>
        <a href="/admin/employees" class={activePage === 'employees' ? 'active' : ''}>
          <i data-lucide="users" class="nav-icon"></i> Employees
        </a>
      </nav>
      <div class="sidebar-footer">
        <div class="user-badge">
          <div class="avatar" id="userAvatar">A</div>
          <div class="user-info">
            <div class="name" id="userName">Admin</div>
            <div class="role" id="userRole">admin</div>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main -->
    <div class="admin-main">
      <header class="admin-header">
        <button class="btn btn-icon btn-secondary mobile-menu-btn" id="menuToggle" style="display:none;">
          <i data-lucide="menu"></i>
        </button>
        <h1 class="page-title">{title}</h1>
        <div class="header-actions">
          <button class="btn btn-sm btn-danger" id="logoutBtn">
            <i data-lucide="log-out" style="width:16px;"></i> Logout
          </button>
        </div>
      </header>
      <main class="admin-content">
        <slot />
      </main>
    </div>
  </div>

  <!-- Toast container -->
  <div id="toastContainer"></div>

  <script is:inline>
    // ─── API Config ───
    const API_BASE = 'http://localhost:8000/api';

    function getToken() { return localStorage.getItem('kpt_token'); }
    function getUser() { try { return JSON.parse(localStorage.getItem('kpt_user')); } catch { return null; } }

    async function apiCall(endpoint, options = {}) {
      const token = getToken();
      const headers = { 'Content-Type': 'application/json', ...(options.headers || {}) };
      if (token) headers['Authorization'] = `Bearer ${token}`;
      const res = await fetch(`${API_BASE}${endpoint}`, { ...options, headers });
      const data = await res.json();
      if (res.status === 401) { localStorage.removeItem('kpt_token'); localStorage.removeItem('kpt_user'); window.location.href = '/admin/login'; return; }
      if (!res.ok) throw new Error(data.error || 'Request failed');
      return data;
    }

    function showToast(message, type = 'success') {
      const c = document.getElementById('toastContainer');
      const t = document.createElement('div');
      t.className = `toast ${type}`;
      t.textContent = message;
      c.appendChild(t);
      requestAnimationFrame(() => t.classList.add('show'));
      setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 300); }, 3000);
    }

    // ─── Auth check ───
    (function() {
      const token = getToken();
      const user  = getUser();
      if (!token || !user) { window.location.href = '/admin/login'; return; }
      const avatarEl = document.getElementById('userAvatar');
      const nameEl   = document.getElementById('userName');
      const roleEl   = document.getElementById('userRole');
      if (avatarEl) avatarEl.textContent = (user.full_name || 'A')[0].toUpperCase();
      if (nameEl) nameEl.textContent = user.full_name || user.username;
      if (roleEl) roleEl.textContent = user.role;
    })();

    // ─── Logout ───
    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      try { await apiCall('/auth/logout.php', { method: 'POST' }); } catch {}
      localStorage.removeItem('kpt_token');
      localStorage.removeItem('kpt_user');
      window.location.href = '/admin/login';
    });

    // ─── Mobile menu ───
    const menuBtn = document.getElementById('menuToggle');
    const sidebar = document.getElementById('sidebar');
    if (window.innerWidth <= 768 && menuBtn) menuBtn.style.display = 'flex';
    menuBtn?.addEventListener('click', () => sidebar.classList.toggle('open'));

    // Initialize icons
    lucide.createIcons();
  </script>
</body>
</html>
